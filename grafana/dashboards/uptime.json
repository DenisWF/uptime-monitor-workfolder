{
  "uid": "uptime-monitor",
  "title": "Uptime Monitor",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime, 24 ч (%)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "uptime-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": true, "fields": "/^uptime_pct$/", "limit": 50 },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.name, ROUND(100.0 * AVG(c.is_up::int), 2) AS uptime_pct FROM checks c JOIN targets t ON t.id = c.target_id WHERE c.checked_at > now() - interval '24 hours' GROUP BY t.name ORDER BY t.name"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Время ответа, мс",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "uptime-postgres" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', c.checked_at) AS time, t.name AS metric, AVG(c.response_ms) AS value FROM checks c JOIN targets t ON t.id = c.target_id WHERE $__timeFilter(c.checked_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Последние сбои",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "uptime-postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT c.checked_at AS time, t.name, c.status_code, c.error FROM checks c JOIN targets t ON t.id = c.target_id WHERE NOT c.is_up ORDER BY c.checked_at DESC LIMIT 20"
        }
      ]
    }
  ]
}